{
  "name": "foresights-dashboard-template",
  "version": "0.2.0",
  "private": true,
  "description": "TypeScript source for the Foresights dashboard artifact. Compiled at wizard time by the /create-dashboard skill, then injected into dashboard.html and shipped via mcp__cowork__create_artifact. Not published to npm.",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "esbuild dashboard.ts --bundle --format=iife --target=es2022 --sourcemap=inline --outfile=dist/dashboard.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "npm run lint && npm run typecheck && npm run prebuild-wizard && npm run test",
    "wizard:build": "tsx wizard/build.ts",
    "prebuild-wizard": "esbuild wizard/build.ts wizard/refresh.ts --bundle --platform=node --target=node20 --format=esm --outdir=wizard --out-extension:.js=.js --allow-overwrite --external:esbuild-wasm --external:jsdom"
  },
  "dependencies": {
    "esbuild-wasm": "0.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.7.5",
    "esbuild": "0.24.0",
    "jsdom": "25.0.1",
    "tsx": "^4.22.3",
    "typescript": "5.6.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
